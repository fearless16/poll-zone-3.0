{
  "name": "poll-zone",
  "private": true,
  "version": "3.0.0",
  "scripts": {
    "dev": "bunx vite",
    "build": "bunx vite build",
    "preview": "bunx vite preview",
    "lint": "bunx eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "bunx eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "test": "firebase emulators:exec --project poll-zone 'bunx vitest run --coverage --passWithNoTests'",
    "test:ci": "firebase emulators:exec --project poll-zone 'bunx vitest run --coverage'",
    "test:watch": "firebase emulators:exec --project poll-zone 'bunx vitest --watch'"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/react-fontawesome": "0.2.2",
    "@iconify/react": "6.0.0",
    "bootstrap": "^5.3.6",
    "bootstrap-switch-button-react": "^1.2.0",
    "chart.js": "^4.4.9",
    "firebase": "^11.6.1",
    "react": "18.3.1",
    "react-bootstrap": "^2.0.2",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.2.1",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "latest",
    "@types/react": "18.3.21",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.1.3",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "firebase-tools": "14.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "rollup": "4.40.1",
    "vite": "^6.3.4",
    "vitest": "^3.1.2"
  }
}
