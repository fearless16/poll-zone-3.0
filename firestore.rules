rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {

      // ── Reads ─────────────────────────────────────────────────
      // Allow single-document reads (getDoc, onSnapshot on a doc).
      // Block collection listing so no one can enumerate all rooms.
      allow get: if true;
      allow list: if false;

      // ── Deletes ───────────────────────────────────────────────
      allow delete: if false;

      // ── Creates ───────────────────────────────────────────────
      allow create: if isValidRoomCreate(request.resource.data);

      // ── Updates ───────────────────────────────────────────────
      allow update: if isValidRoomUpdate(resource.data, request.resource.data);
    }

    // Block every other collection entirely
    match /{document=**} {
      allow read, write: if false;
    }
  }

  // ================================================================
  // CREATE – validate the initial room document shape
  // ================================================================
  function isValidRoomCreate(data) {
    return data.keys().hasAll(['host', 'roomName', 'participants', 'createdAt', 'poll'])
      && data.keys().hasOnly(['host', 'roomName', 'participants', 'createdAt', 'poll'])
      // host
      && data.host is string
      && data.host.size() > 0
      && data.host.size() <= 128
      // roomName
      && data.roomName is string
      && data.roomName.size() > 0
      && data.roomName.size() <= 200
      // participants – exactly 1 entry on creation
      && data.participants is list
      && data.participants.size() == 1
      // createdAt
      && data.createdAt is timestamp
      // poll – must start empty
      && data.poll is map
      && data.poll.size() == 0;
  }

  // ================================================================
  // UPDATE – route to the correct validation based on what changed
  // ================================================================
  function isValidRoomUpdate(before, after) {
    // Only the known top-level keys are allowed
    return after.keys().hasOnly(['host', 'roomName', 'participants', 'createdAt', 'poll'])
      // Immutable fields – must never change
      && after.host == before.host
      && after.roomName == before.roomName
      && after.createdAt == before.createdAt
      // Participants can only grow, capped at 500
      && after.participants is list
      && after.participants.size() >= before.participants.size()
      && after.participants.size() <= 500
      // Exactly one of the four valid operations
      && (
           isJoin(before, after)
        || isNewPoll(before, after)
        || isVote(before, after)
        || isPollClose(before, after)
      );
  }

  // ── JOIN ─────────────────────────────────────────────────────
  // participants grows by exactly 1, poll is untouched
  function isJoin(before, after) {
    return after.participants.size() == before.participants.size() + 1
      && after.poll == before.poll;
  }

  // ── CREATE / REPLACE POLL ────────────────────────────────────
  // Host creates a new poll (from empty) or replaces a closed poll.
  // Participants must stay the same.
  function isNewPoll(before, after) {
    return after.participants == before.participants
      // Can only create poll when none exists or previous is closed
      && (before.poll.size() == 0 || before.poll.isOpen == false)
      // Validate the new poll shape
      && after.poll.keys().hasAll(['type', 'question', 'options', 'voted', 'isOpen', 'createdAt'])
      && after.poll.keys().hasOnly(['type', 'question', 'options', 'voted', 'isOpen', 'createdAt'])
      && after.poll.type is string
      && (after.poll.type == 'voting' || after.poll.type == 'estimation')
      && after.poll.question is string
      && after.poll.question.size() <= 500
      && after.poll.options is list
      && after.poll.options.size() >= 2
      && after.poll.options.size() <= 8
      && after.poll.voted is list
      && after.poll.voted.size() == 0
      && after.poll.isOpen == true
      && after.poll.createdAt is timestamp;
  }

  // ── CAST VOTE ────────────────────────────────────────────────
  // voted array grows by exactly 1, poll stays open,
  // options array length unchanged, question/type/createdAt frozen.
  function isVote(before, after) {
    return after.participants == before.participants
      // Poll must be open before and after
      && before.poll.isOpen == true
      && after.poll.isOpen == true
      // voted grows by exactly 1
      && after.poll.voted is list
      && after.poll.voted.size() == before.poll.voted.size() + 1
      // options count unchanged
      && after.poll.options is list
      && after.poll.options.size() == before.poll.options.size()
      // Immutable poll fields
      && after.poll.question == before.poll.question
      && after.poll.type == before.poll.type
      && after.poll.createdAt == before.poll.createdAt
      // lastUpdated must be set
      && after.poll.lastUpdated is timestamp;
  }

  // ── CLOSE POLL ───────────────────────────────────────────────
  // isOpen flips true → false, everything else frozen.
  function isPollClose(before, after) {
    return after.participants == before.participants
      && before.poll.isOpen == true
      && after.poll.isOpen == false
      // All other poll data frozen
      && after.poll.voted == before.poll.voted
      && after.poll.options == before.poll.options
      && after.poll.question == before.poll.question
      && after.poll.type == before.poll.type
      && after.poll.createdAt == before.poll.createdAt;
  }
}
